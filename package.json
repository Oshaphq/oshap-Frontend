{
  "name": "oshap",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev --workspace @oshap/customer",
    "dev:admin": "npm run dev --workspace @oshap/admin",
    "build:customer": "npm run build --workspace @oshap/customer",
    "build:admin": "npm run build --workspace @oshap/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
