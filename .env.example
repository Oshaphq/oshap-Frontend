# ===========================================================================
# Customer & Admin frontend env vars (consumed by Vite via import.meta.env)
# Copy this file to .env.local inside each app or set at the workspace root.
# ===========================================================================

# Base URL for the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api

# Admin app — FCM web push (merchant notifications)
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FCM_API_KEY=
VITE_FCM_AUTH_DOMAIN=
VITE_FCM_PROJECT_ID=
VITE_FCM_STORAGE_BUCKET=
VITE_FCM_MESSAGING_SENDER_ID=
VITE_FCM_APP_ID=
VITE_FCM_VAPID_KEY=

# Restaurant identity is PIN-derived via GET /admin/me — no env var needed.
