# ===========================================================================
# Customer, Admin & Platform frontend env vars (consumed by Vite via
# import.meta.env). Copy this file to .env.local at the workspace root, or
# inside each app under apps/<app>/.
# ===========================================================================

# Origin of the FastAPI backend — scheme + host + port ONLY.
# Do NOT append /api or /api/v1: the shared client owns that prefix
# (API_PREFIX in packages/shared/src/api/client.ts) so a mistyped env var
# can't silently 404 every endpoint.
# If unset, the apps fall back to the in-memory mock API (see VITE_MOCK_API).
VITE_API_BASE_URL=http://localhost:8000

# Force the in-memory mock backend even when VITE_API_BASE_URL is set.
# Leave blank/unset for real backend; set to "true" for offline/mock dev.
# (When VITE_API_BASE_URL is unset, mock mode is enabled automatically.)
VITE_MOCK_API=

# Admin app — public origin of the CUSTOMER app. Table QR codes encode
# {VITE_CUSTOMER_APP_URL}/menu?table={id}, so this must be the URL a guest's
# phone can actually reach — not localhost, once you print anything for real.
# Falls back to http://localhost:5173 in dev.
VITE_CUSTOMER_APP_URL=http://localhost:5173

# Mock-only: WebSocket relay that syncs mock state across the customer/admin
# apps (different origins don't share localStorage). Defaults to the local
# dev relay (`npm run relay`, ws://localhost:5175). For a DEPLOYED mock demo
# (e.g. on Vercel), host ws-relay.js somewhere that supports long-lived
# WebSockets (Railway/Render/Fly — not Vercel) and set the wss:// URL here.
VITE_MOCK_RELAY_URL=

# Admin app — FCM web push (merchant notifications)
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FCM_API_KEY=
VITE_FCM_AUTH_DOMAIN=
VITE_FCM_PROJECT_ID=
VITE_FCM_STORAGE_BUCKET=
VITE_FCM_MESSAGING_SENDER_ID=
VITE_FCM_APP_ID=
VITE_FCM_VAPID_KEY=

# Platform app (apps/platform) — internal operator portal access code.
# The login screen validates input against this value, and the shared client
# sends it to the backend as the `x-platform-token` header on /platform/* calls.
# If unset, the login gate is open (dev only) — always set this in production.
VITE_PLATFORM_TOKEN=

# Restaurant identity is PIN-derived via GET /admin/me — no env var needed.

# ---------------------------------------------------------------------------
# Dev ports: customer 5173, admin 5174, mock WS relay (ws-relay.js) 5175,
# platform 5176.
# ---------------------------------------------------------------------------
